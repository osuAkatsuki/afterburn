FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY src ./src
COPY tsconfig.server.json ./
COPY tsconfig.json ./
RUN npm run typecheck && npm run build:server

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV SERVE_CLIENT=0
ENV PORT=8092

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist/node ./dist/node

EXPOSE 8092

CMD ["node", "dist/node/server/index.js"]
