{
  "name": "afterburn",
  "version": "1.0.0",
  "description": "Browser-based multiplayer arcade fighter jet dogfighting game.",
  "type": "module",
  "main": "dist/node/server/index.js",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/node/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "0.164.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.14.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "tsx": "^4.21.0",
    "typescript": "5.5.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": "^6.4.2"
  }
}
